#!/usr/bin/env python3
"""KOPITIAM token-cost accounting hook (prepare-commit-msg).

Purpose
-------
Every commit carries a standard, machine-readable trailer accounting for the
AI token cost of the work that produced it. This keeps the CLAUDE.md promise
that "AI accelerates, knowledge endures": the cost of each accelerated change
is recorded in the durable git history rather than lost to chat sessions.

Behaviour
---------
Appends a single ``Token-Cost:`` git trailer to the commit message. The hook is
idempotent (never stamps twice — safe across ``--amend`` and rebases) and skips
merge/squash commits, whose messages are generated by git itself.

The values are read from the environment, so an agent (or a wrapper script) can
populate real figures for the session that produced the commit:

    KOPITIAM_TOKENS_IN      prompt/input tokens        (int)
    KOPITIAM_TOKENS_OUT     completion/output tokens   (int)
    KOPITIAM_TOKEN_COST_USD dollar cost                (float, e.g. 0.42)
    KOPITIAM_AI_MODEL       model id                   (e.g. north-mini-code)

When nothing is supplied the trailer is stamped as ``unmetered`` — an explicit,
honest record that this commit was not instrumented, never a fabricated number.

This hook is intentionally dependency-free (Python stdlib only) to honour the
Pure Rust Core's spirit of minimal, portable tooling.
"""

from __future__ import annotations

import os
import sys

TRAILER_KEY = "Token-Cost"

# Commit-message sources for which git generates the body itself; stamping these
# adds noise to merge/squash summaries, so we leave them alone.
SKIP_SOURCES = {"merge", "squash"}


def _fmt_int(raw: str | None) -> str | None:
    if raw is None or raw.strip() == "":
        return None
    try:
        return f"{int(raw.strip()):,}"
    except ValueError:
        return raw.strip()


def build_trailer() -> str:
    """Compose the standard Token-Cost trailer value from the environment."""
    tokens_in = _fmt_int(os.environ.get("KOPITIAM_TOKENS_IN"))
    tokens_out = _fmt_int(os.environ.get("KOPITIAM_TOKENS_OUT"))
    usd = os.environ.get("KOPITIAM_TOKEN_COST_USD", "").strip()
    model = os.environ.get("KOPITIAM_AI_MODEL", "").strip()

    parts: list[str] = []
    if tokens_in is not None:
        parts.append(f"{tokens_in} in")
    if tokens_out is not None:
        parts.append(f"{tokens_out} out")
    metered = " / ".join(parts)
    if metered:
        metered += " tok"

    tail: list[str] = []
    if usd:
        tail.append(f"${usd}" if not usd.startswith("$") else usd)
    if model:
        tail.append(f"model={model}")

    segments = [s for s in (metered, "; ".join(tail)) if s]
    return "; ".join(segments) if segments else "unmetered"


def already_stamped(lines: list[str]) -> bool:
    return any(line.startswith(f"{TRAILER_KEY}:") for line in lines)


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        return 0  # No message file path; nothing to do.

    msg_path = argv[1]
    source = argv[2] if len(argv) > 2 else ""
    if source in SKIP_SOURCES:
        return 0

    try:
        with open(msg_path, "r", encoding="utf-8") as fh:
            content = fh.read()
    except OSError:
        return 0  # Never block a commit over hook I/O.

    lines = content.splitlines()
    if already_stamped(lines):
        return 0

    # Separate the human message from git's trailing comment block (lines that
    # start with '#'), so the trailer lands after real content, before comments.
    body_lines: list[str] = []
    comment_lines: list[str] = []
    in_comments = False
    for line in lines:
        if line.startswith("#"):
            in_comments = True
        (comment_lines if in_comments else body_lines).append(line)

    while body_lines and body_lines[-1].strip() == "":
        body_lines.pop()

    trailer = f"{TRAILER_KEY}: {build_trailer()}"

    out: list[str] = list(body_lines)
    out.append("")  # blank line -> valid git trailer block
    out.append(trailer)
    if comment_lines:
        out.append("")
        out.extend(comment_lines)

    try:
        with open(msg_path, "w", encoding="utf-8") as fh:
            fh.write("\n".join(out) + "\n")
    except OSError:
        return 0

    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
